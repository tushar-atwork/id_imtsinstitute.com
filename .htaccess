Options -Indexes
RewriteEngine On

# Deny private application/config/database/storage paths.
RewriteRule ^(app|config|database|storage)/ - [F,L,NC]
RewriteRule ^(install\.php|sync\.php)$ - [F,L,NC]

# Route web root to public/.
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^$ public/index.php [L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(login\.php|logout\.php|run-sync\.php|index\.php)$ public/$1 [L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
